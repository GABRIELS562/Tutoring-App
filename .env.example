# ============================================================================
# Angelo Tutoring Platform - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Authentication
# ----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
# Leave empty to run in demo mode (for development without auth)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/angelo_tutoring
# Leave empty to run in demo mode (for development without database)

DATABASE_URL=

# ----------------------------------------------------------------------------
# AI Integration (Optional)
# ----------------------------------------------------------------------------
# Anthropic Claude API for AI hint generation
# Get from: https://console.anthropic.com/

ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# Email Service (Optional)
# ----------------------------------------------------------------------------
# Resend API for transactional emails
# Get from: https://resend.com/api-keys

RESEND_API_KEY=

# Email sender configuration
RESEND_FROM_EMAIL=noreply@angelo-tutoring.com

# ----------------------------------------------------------------------------
# Payment Gateway (Optional)
# ----------------------------------------------------------------------------
# PayFast for South African payments
# Get from: https://www.payfast.co.za/

PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# PayFast configuration
PAYFAST_PASSPHRASE=
PAYFAST_MODE=test  # 'test' or 'live'

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
# Base URL for the application (used for emails, redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Build configuration
NEXT_PUBLIC_BUILD_ID=local

# ----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# ----------------------------------------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Feature Flags (Optional)
# ----------------------------------------------------------------------------
# Enable/disable features in development
NEXT_PUBLIC_ENABLE_AI_HINTS=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# Secret key for session encryption (generate with: openssl rand -base64 32)
SESSION_SECRET=

# CSRF token secret
CSRF_SECRET=

# ----------------------------------------------------------------------------
# Development/Debugging
# ----------------------------------------------------------------------------
# Set to 'true' to run without database/auth (for testing UI)
NEXT_PUBLIC_DEMO_MODE=false

# Enable verbose logging
DEBUG=false

# ----------------------------------------------------------------------------
# CI/CD Variables (Set in GitLab CI/CD Settings, not in .env files)
# ----------------------------------------------------------------------------
# These should be configured in GitLab:
# - CI_REGISTRY_IMAGE
# - CI_REGISTRY_USER
# - CI_REGISTRY_PASSWORD
# - STAGING_SERVER_HOST
# - STAGING_SSH_PRIVATE_KEY
# - PRODUCTION_SERVER_HOST
# - PRODUCTION_SSH_PRIVATE_KEY
# - VERCEL_TOKEN (if using Vercel)
# - DEPLOY_METHOD (vercel, vps, or kubernetes)
