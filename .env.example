# Copy to .env.local and fill in. DO NOT commit .env.local.
# Leave the Supabase/DATABASE_URL vars empty to run in demo mode.

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection string (Drizzle). Pooled (port 6543) at runtime,
# direct (port 5432) for migrations — see DEPLOYMENT.md.
DATABASE_URL=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model id read by src/app/api/ai-hint/route.ts (wired on another branch).
ANTHROPIC_MODEL=claude-sonnet-5

# WARNING: grants admin access to the Supabase user with this email,
# even if their `users.is_admin` row is false. Set carefully.
ADMIN_EMAIL=
